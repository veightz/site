---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---
<Base title="Veight">
  <main>
    <h1>Veight</h1>
    <p class="lead">个人网站，施工中。</p>
    {posts.length > 0 && (
      <section class="posts">
        <h2>文章</h2>
        <ul>
          {posts.map((post) => (
            <li>
              <a href={`/posts/${post.id}/`}>{post.data.title}</a>
              <time datetime={post.data.date.toISOString().slice(0, 10)}>
                {post.data.date.toISOString().slice(0, 10)}
              </time>
              {post.data.summary && <p>{post.data.summary}</p>}
            </li>
          ))}
        </ul>
      </section>
    )}
  </main>
</Base>
<style>
  main {
    max-width: 42rem;
    margin: 0 auto;
    padding: 2rem 1.25rem 3rem;
  }
  h1 {
    margin: 0 0 .5rem;
    font-size: clamp(2rem, 6vw, 2.75rem);
    font-weight: 650;
    letter-spacing: -.02em;
  }
  .lead { margin: 0 0 2rem; color: var(--muted); font-size: 1.1rem; }
  .posts h2 {
    margin: 0 0 1rem;
    font-size: 1rem;
    font-weight: 600;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: .04em;
  }
  .posts ul { list-style: none; margin: 0; padding: 0; }
  .posts li {
    margin: 0 0 1.25rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border);
  }
  .posts li:last-child { border-bottom: none; }
  .posts a {
    display: block;
    color: var(--fg);
    font-weight: 600;
    font-size: 1.1rem;
    line-height: 1.4;
  }
  .posts a:hover { color: var(--link); }
  .posts time {
    display: block;
    margin-top: .25rem;
    color: var(--muted);
    font-size: .85rem;
  }
  .posts p {
    margin: .4rem 0 0;
    color: var(--muted);
    font-size: .95rem;
  }
</style>
