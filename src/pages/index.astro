<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Veight</title>
  </head>
  <body>
    <main>
      <h1>Veight</h1>
      <p>个人网站，施工中。</p>
    </main>
  </body>
</html>
<style is:global>
  :root {
    color-scheme: light dark;
    --bg: #fafaf9;
    --fg: #1c1917;
    --muted: #78716c;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #151413;
      --fg: #f5f5f4;
      --muted: #a8a29e;
    }
  }
  html, body { height: 100%; margin: 0; }
  body {
    display: grid;
    place-items: center;
    background: var(--bg);
    color: var(--fg);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Noto Sans CJK SC", sans-serif;
  }
  main { text-align: center; padding: 1.5rem; }
  h1 { margin: 0 0 .5rem; font-size: clamp(2rem, 6vw, 3rem); font-weight: 600; letter-spacing: -.02em; }
  p { margin: 0; color: var(--muted); font-size: 1.1rem; }
</style>
