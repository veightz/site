---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const date = post.data.date.toISOString().slice(0, 10);
---
<Base title={`${post.data.title} · Veight`} description={post.data.summary}>
  <main class="post">
    <p class="meta"><time datetime={date}>{date}</time></p>
    <h1>{post.data.title}</h1>
    {post.data.summary && <p class="summary">{post.data.summary}</p>}
    <article class="body">
      <Content />
    </article>
    <p class="back"><a href="/">← 返回</a></p>
  </main>
</Base>
<style>
  .post {
    max-width: 42rem;
    margin: 0 auto;
    padding: 1rem 1.25rem 3rem;
  }
  .meta {
    margin: 0 0 .5rem;
    color: var(--muted);
    font-size: .9rem;
  }
  h1 {
    margin: 0 0 .75rem;
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 650;
    letter-spacing: -.02em;
    line-height: 1.3;
  }
  .summary {
    margin: 0 0 1.75rem;
    color: var(--muted);
    font-size: 1.05rem;
  }
  .body :global(h2) {
    margin: 2rem 0 .75rem;
    font-size: 1.25rem;
    font-weight: 650;
  }
  .body :global(h3) {
    margin: 1.5rem 0 .5rem;
    font-size: 1.1rem;
    font-weight: 600;
  }
  .body :global(p),
  .body :global(ul),
  .body :global(ol),
  .body :global(table) {
    margin: 0 0 1rem;
  }
  .body :global(li) { margin: .25rem 0; }
  .body :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: .95rem;
  }
  .body :global(th),
  .body :global(td) {
    border: 1px solid var(--border);
    padding: .5rem .65rem;
    text-align: left;
    vertical-align: top;
  }
  .body :global(th) { background: color-mix(in srgb, var(--border) 40%, transparent); }
  .body :global(hr) {
    border: none;
    border-top: 1px solid var(--border);
    margin: 2rem 0;
  }
  .body :global(em) { color: var(--muted); }
  .back { margin-top: 2.5rem; }
</style>
